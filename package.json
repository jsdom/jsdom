{
  "name": "jsdom",
  "version": "30.1.3",
  "description": "A JavaScript implementation of many web standards",
  "keywords": [
    "dom",
    "html",
    "w3c",
    "whatwg"
  ],
  "license": "MIT",
  "maintainers": [
    "Elijah Insua <tmpvar@gmail.com> (http://tmpvar.com)",
    "Domenic Denicola <d@domenic.me> (https://domenic.me/)",
    "Sebastian Mayr <sebmaster16@gmail.com> (https://blog.smayr.name/)",
    "Joris van der Wel <joris@jorisvanderwel.com>",
    "Timothy Gu <timothygu99@gmail.com> (https://timothygu.me/)",
    "Magne Andersson <code@zirro.se> (https://zirro.se/)",
    "Pierre-Marie Dartus <dartus.pierremarie@gmail.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsdom/jsdom.git"
  },
  "files": [
    "lib/",
    "!lib/**/*.webidl"
  ],
  "type": "commonjs",
  "main": "./lib/api.js",
  "scripts": {
    "check": "npm run lint && npm run fmt:check",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "wireit",
    "prepare:convert-idl": "wireit",
    "prepare:generate-event-sets": "wireit",
    "prepare:generate-css-style-properties": "wireit",
    "prepare:generate-js-globals": "wireit",
    "prepare:generate-default-stylesheet": "wireit",
    "prepare:generate-css-initial-values": "wireit",
    "prepare:generate-dom-data": "wireit",
    "prepare:generate-css-data": "wireit",
    "pretest": "npm run prepare && npm run wpt:init",
    "test": "npm-run-all --continue-on-error test:*",
    "test:api": "mocha test/api/",
    "test:eslint": "mocha scripts/eslint-plugin/tests/*.mjs",
    "test:to-port-to-wpts": "mocha test/to-port-to-wpts/ && mocha test/to-port-to-wpts/level1/ && mocha test/to-port-to-wpts/level2/ && mocha test/to-port-to-wpts/level3/",
    "test:tuwpt": "mocha test/web-platform-tests/run-tuwpts.js",
    "test:tuwpt:browser": "node scripts/verify-tuwpts-in-browser.mjs",
    "test:wpt": "mocha test/web-platform-tests/run-wpts.js",
    "bench": "node benchmark/runner.js",
    "bench:compare": "node benchmark/compare.js",
    "wpt:init": "git submodule update --init --recursive",
    "wpt:reset": "rm -rf ./test/web-platform-tests/tests && npm run wpt:init",
    "wpt:update": "git submodule update --init --recursive --remote && cd test/web-platform-tests/tests && python wpt.py manifest --path ../wpt-manifest.json"
  },
  "wireit": {
    "prepare": {
      "dependencies": [
        "prepare:convert-idl",
        "prepare:generate-event-sets",
        "prepare:generate-js-globals",
        "prepare:generate-default-stylesheet"
      ]
    },
    "prepare:convert-idl": {
      "command": "node ./scripts/webidl/convert.mjs",
      "dependencies": [
        "prepare:generate-css-style-properties"
      ]
    },
    "prepare:generate-event-sets": {
      "command": "node ./scripts/generate-event-sets.mjs"
    },
    "prepare:generate-css-style-properties": {
      "command": "node ./scripts/generate-css-style-properties.mjs",
      "dependencies": [
        "prepare:generate-css-data"
      ]
    },
    "prepare:generate-js-globals": {
      "command": "node ./scripts/generate-js-globals.mjs"
    },
    "prepare:generate-default-stylesheet": {
      "command": "node ./scripts/generate-default-stylesheet.mjs",
      "dependencies": [
        "prepare:generate-css-initial-values"
      ]
    },
    "prepare:generate-css-initial-values": {
      "command": "node ./scripts/generate-css-initial-values.mjs",
      "dependencies": [
        "prepare:convert-idl",
        "prepare:generate-dom-data"
      ]
    },
    "prepare:generate-dom-data": {
      "command": "node ./scripts/generate-dom-data.mjs"
    },
    "prepare:generate-css-data": {
      "command": "node ./scripts/generate-css-data.mjs"
    }
  },
  "dependencies": {
    "@exodus/bytes": "^1.16.0",
    "bcp-47": "^2.1.2",
    "bcp-47-match": "^2.0.3",
    "data-urls": "^8.0.0",
    "decimal.js": "^10.6.0",
    "html-encoding-sniffer": "^7.0.0",
    "is-potential-custom-element-name": "^1.0.1",
    "lru-cache": "^11.5.3",
    "parse5": "^8.0.1",
    "parse5-parser-stream": "^8.0.0",
    "saxes": "^6.0.0",
    "tough-cookie": "^6.0.2",
    "undici": "^8.12.3",
    "w3c-xmlserializer": "^6.0.0",
    "webidl-conversions": "^8.0.1",
    "whatwg-mimetype": "^5.0.0",
    "whatwg-url": "^17.3.0",
    "xml-name-validator": "^5.0.0"
  },
  "devDependencies": {
    "@csstools/css-syntax-patches-for-csstree": "^1.1.15",
    "@domenic/eslint-config": "^6.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@unicode/unicode-17.0.0": "^2.1.0",
    "@webref/css": "^8.7.8",
    "css-tree": "^3.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "js-yaml": "^5.5.0",
    "language-subtag-registry": "^0.4.2",
    "mocha": "^12.0.3",
    "mocha-sugar-free": "^1.4.0",
    "npm-run-all2": "^9.0.4",
    "opener": "^1.5.2",
    "oxfmt": "0.75.0",
    "semver": "^7.8.5",
    "server-destroy": "^1.0.1",
    "tinybench": "^6.2.2",
    "webidl2": "^24.5.0",
    "webidl2js": "^21.2.0",
    "wireit": "^0.15.0"
  },
  "peerDependencies": {
    "@napi-rs/canvas": "^1.0.10"
  },
  "peerDependenciesMeta": {
    "@napi-rs/canvas": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
